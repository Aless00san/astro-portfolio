---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;

const certificates = [
  {
    file: "CssCert.pdf",
    title: "CSS",
    issuedBy: "Zenva Academy",
  },
  {
    file: "HtmlCerrt.pdf",
    title: "HTML",
    issuedBy: "Zenva Academy",
  },
  {
    file: "JavaScriptCert.pdf",
    title: "JavaScript",
    issuedBy: "Code With Mosh",
  },
  {
    file: "SpringCert.pdf",
    title: "Spring Framework",
    issuedBy: "Udemy",
  },
];
---

<Layout>
  <div class="section certs-page">
    <div class="container">
      <p class="certs-back">
        <a href={base}>&larr; Back to portfolio</a>
      </p>

      <h1 class="title is-2 certs-title">Certificates</h1>

      <ul class="certs-list">
        {certificates.map((cert) => (
          <li>
            <a
              class="cert-card"
              href={base + "certificates/" + cert.file}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="cert-icon" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <polyline points="14 2 14 8 20 8" />
                  <line x1="16" y1="13" x2="8" y2="13" />
                  <line x1="16" y1="17" x2="8" y2="17" />
                </svg>
              </span>
              <span class="cert-body">
                <span class="cert-title">{cert.title}</span>
                <span class="cert-meta">
                  Certificate{cert.issuedBy ? ` · ${cert.issuedBy}` : ""} · PDF
                </span>
              </span>
              <span class="cert-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Layout>

<style>
  .certs-page {
    min-height: calc(100vh - 4rem);
    background-color: var(--bg);
  }

  .certs-back {
    margin-bottom: 2.5rem;
  }

  .certs-back a {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--transition);
  }

  .certs-back a:hover {
    color: var(--primary-hover);
  }

  .certs-title {
    font-weight: 800;
  }

  .certs-sub {
    color: var(--text-muted);
    margin-bottom: 2.5rem;
  }

  .certs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
  }

  .cert-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition: transform var(--transition), box-shadow var(--transition),
      border-color var(--transition);
  }

  .cert-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary);
  }

  .cert-icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    background: var(--primary-grad);
    color: #fff;
  }

  .cert-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .cert-title {
    font-weight: 600;
    font-size: 1rem;
    color: var(--text);
  }

  .cert-meta {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-top: 0.15rem;
  }

  .cert-arrow {
    margin-left: auto;
    color: var(--text-muted);
    transition: color var(--transition), transform var(--transition);
  }

  .cert-card:hover .cert-arrow {
    color: var(--primary-hover);
    transform: translateX(3px);
  }
</style>