---
import TechCarousel from "./TechCarousel.astro";
const base = import.meta.env.BASE_URL;
---

<div class="section">
  <div class="container">
    <div class="columns is-vcentered is-variable is-8">
      <!-- Image Column -->
      <div class="column is-one-third">
        <figure class="about-portrait">
          <img
            src={base + "portrait.png"}
            alt="Portrait"
            loading="lazy"
          />
        </figure>
      </div>

      <!-- Text Column -->
      <div class="column">
        <h2 class="title is-2 mt-2">About Me</h2>
        <p class="subtitle is-5">
          I'm a Multiplatform Applications Developer with a certificate in
          higher education and hands-on experience designing and implementing
          real-world software. I gravitate toward clean, maintainable, and
          open-source-friendly code, and I enjoy turning everyday problems into
          efficient, usable applications.
        </p>
      </div>
    </div>
  </div>
</div>
<div class="mt-4 mb-4">
  <TechCarousel />
</div>

<style>
  .about-portrait {
    width: 100%;
    max-width: 16rem;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.18);
  }

  .about-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
</style>
