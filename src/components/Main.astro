---
import About from "./About.astro";
import Hero from "./Hero.astro";
import Experience from "./Experience.astro";
import Projects from "./Projects.astro";
import Contact from "./Contact.astro";
---

<div id="container">
  <main>
    <div class="intro-band">
      <section id="hero">
        <Hero />
      </section>

      <section id="about">
        <About />
      </section>
    </div>

    <Experience />

    <section id="projects" class="shallFlex">
      <Projects />
    </section>

    <section id="contact">
      <Contact />
    </section>
  </main>
</div>

<style>
  #container {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .intro-band {
    position: relative;
    overflow: hidden;
    background-color: var(--bg);
  }

  /* Dotted background pattern */
  .intro-band::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(
      circle at 1px 1px,
      rgba(156, 163, 245, 0.5) 1px,
      transparent 1px
    );
    background-size: 24px 24px;
    opacity: 0.25;
  }

  .intro-band #hero,
  .intro-band #about {
    position: relative;
    z-index: 1;
  }

  #hero {
    display: flex;
    align-items: start;
    flex-direction: column;
    padding: 4rem 1rem 3rem;
  }

  @media screen and (max-width: 768px) {
    #hero {
      display: block;
      padding-top: 2.5rem;
    }

    #hero .title {
      line-height: 1.4;
    }
  }
</style>
