---
const base = import.meta.env.BASE_URL;
---

<section class="section projects" id="projects">
  <div class="container">
    <h2 class="title is-2 section-title">Projects</h2>
    <p class="subtitle section-subtitle">
      A few highlights from my personal and professional work.
    </p>
    <div class="columns is-multiline mobile-rws">
      <!-- Project 1 -->
      <div class="column is-one-third">
        <div class="card">
          <div class="card-image">
            <a href="https://github.com/Aless00san/Gunpla-API" target="_blank">
              <figure class="image is-4by3">
                <img
                  class="project-image"
                  src={base + "images/GunplaDB.png"}
                  alt="Project 1 Screenshot"
                />
              </figure>
            </a>
          </div>
          <div class="card-content">
            <p class="title is-5">GunplaDB</p>
            <p class="subtitle is-6">
              A web application featuring a complete Spring Boot backend
              implementation with authentication, role-based access control,
              RESTful APIs, and full database integration
            </p>
            <div class="tags">
              <span class="tag tag-java">Java</span>
              <span class="tag tag-react">React</span>
              <span class="tag tag-spring">SpringBoot</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Project 2 -->
      <div class="column is-one-third">
        <div class="card">
          <div class="card-image">
            <a href="https://github.com/Aless00san/Helldivers-Wordle" target="_blank">
            <figure class="image is-4by3">
              <img
                class="project-image"
                src={base + "images/helldive.gg.png"}
                alt="Project 2 Screenshot"
              />
            </figure>
            </a>
          </div>
          <div class="card-content">
            <p class="title is-5">Helldive.gg</p>
            <p class="subtitle is-6">
              A Wordle-inspired game where players guess stratagems from the
              popular game Helldivers 2. Built entirely in TypeScript, featuring
              user authentication, game history tracking, and an interactive
              stratagem gallery
            </p>
            <div class="tags">
              <span class="tag tag-express">Express.js</span>
              <span class="tag tag-react">React</span>
              <span class="tag tag-axios">Axios</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Project 3 -->
      <div class="column is-one-third">
        <div class="card">
          <div class="card-image">
            <a href="https://pdfsig.xyz/" target="_blank">
            <figure class="image is-4by3">
              <img
                class="project-image"
                src={base + "images/pdfsig.png"}
                alt="Project 3 Screenshot"
              />
            </figure>
            </a>
          </div>
          <div class="card-content">
            <p class="title is-5">Pdf Signature</p>
            <p class="subtitle is-6">
              A web application that enables users to upload and digitally sign
              documents. Dynamically generated QR codes provide a seamless
              signing experience on any mobile device
            </p>
            <div class="tags">
              <span class="tag tag-express">Express.js</span>
              <span class="tag tag-react">React</span>
              <span class="tag tag-multer">Multer</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .projects {
    background-color: var(--bg);
  }

  .section-title {
    text-align: center;
    font-weight: 800;
  }

  .section-subtitle {
    text-align: center;
    color: var(--text-muted);
    margin-bottom: 3rem;
  }

  .card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition),
      border-color var(--transition);
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary);
  }

  .project-image {
    object-fit: cover;
  }
</style>
