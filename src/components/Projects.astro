---
const base = import.meta.env.BASE_URL;
---

<section class="section projects">
  <div class="container">
    <h2 class="title is-2 has-text-centered">Projects</h2>
    <div class="columns is-multiline mobile-rws">
      <!-- Project 1 -->
      <div class="column is-one-third">
        <div class="card">
          <div class="card-image">
            <a href="https://gunpladb.site:5173/" target="_blank">
              <figure class="image is-4by3">
                <img
                  class="project-image"
                  src={base + "images/GunplaDB.png"}
                  alt="Project 1 Screenshot"
                />
              </figure>
            </a>
          </div>
          <div class="card-content">
            <p class="title is-5">GunplaDB</p>
            <p class="subtitle is-6">
              A demo application featuring a complete Spring Boot backend
              implementation with authentication, role-based access control,
              RESTful APIs, and full database integration
            </p>
            <div class="tags">
              <span class="tag is-warning">Java</span>
              <span class="tag is-info">React</span>
              <span class="tag is-success">SpringBoot</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Project 2 -->
      <div class="column is-one-third">
        <div class="card">
          <div class="card-image">
            <a href="https://gg.helldive.site/" target="_blank">
            <figure class="image is-4by3">
              <img
                class="project-image"
                src={base + "images/helldive.gg.png"}
                alt="Project 2 Screenshot"
              />
            </figure>
            </a>
          </div>
          <div class="card-content">
            <p class="title is-5">Helldive.gg</p>
            <p class="subtitle is-6">
              A Wordle-inspired game where players guess stratagems from the
              popular game Helldivers 2. Built entirely in TypeScript, featuring
              user authentication, game history tracking, and an interactive
              stratagem gallery
            </p>
            <div class="tags">
              <span class="tag is-success">Express.js</span>
              <span class="tag is-info">React</span>
              <span class="tag is-danger">Axios</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Project 3 -->
      <div class="column is-one-third">
        <div class="card">
          <div class="card-image">
            <a href="https://pdfsig.xyz/" target="_blank">
            <figure class="image is-4by3">
              <img
                class="project-image"
                src={base + "images/pdfsig.png"}
                alt="Project 3 Screenshot"
              />
            </figure>
            </a>
          </div>
          <div class="card-content">
            <p class="title is-5">Pdf Signature</p>
            <p class="subtitle is-6">
              A web application that enables users to upload and digitally sign
              documents. Dynamically generated QR codes provide a seamless
              signing experience on any mobile device
            </p>
            <div class="tags">
              <span class="tag is-success">Express.js</span>
              <span class="tag is-info">React</span>
              <span class="tag is-danger is-light">Multer</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .projects {
    background-color: var(--bg);
    padding: 4.5rem 1rem;
  }

  .card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition), box-shadow var(--transition),
      border-color var(--transition);
  }

  .card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary);
  }

  .project-image {
    object-fit: cover;
  }
</style>
