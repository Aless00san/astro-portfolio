---
import 'bulma/css/bulma.min.css';
import '../App.css';
const favicon = import.meta.env.BASE_URL + 'favicon.svg';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f1115" />
    <meta
      name="description"
      content="Portfolio of Alessandro Santaniello — full-stack software developer focused on Java and JavaScript."
    />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta name="generator" content={Astro.generator} />
    <title>Alessandro Santaniello · Full-stack Portfolio</title>
  </head>

  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  body > :not(:last-child) {
    flex: 1;
  }
</style>